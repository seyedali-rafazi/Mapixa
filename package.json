{
  "name": "mapixa",
  "version": "1.1.0",
  "description": "A feature-rich, extensible suite of drawing, measurement, navigation, and layer visibility tools for MapLibre GL JS & React.",
  "keywords": [
    "mapixa",
    "maplibre",
    "maplibre-gl",
    "react-map-gl",
    "map-tools",
    "draw-tools",
    "gis",
    "measure",
    "ruler",
    "polygon",
    "marker",
    "geojson"
  ],
  "author": "Seyed Ali Rafazi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seyedali-rafazi/Mapixa.git"
  },
  "bugs": {
    "url": "https://github.com/seyedali-rafazi/Mapixa/issues"
  },
  "homepage": "https://github.com/seyedali-rafazi/Mapixa#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/mapixa.css",
    "./mapixa.css": "./dist/mapixa.css",
    "./dist/style.css": "./dist/mapixa.css",
    "./dist/mapixa.css": "./dist/mapixa.css",
    "./dist/maplibre-gl-tools.css": "./dist/mapixa.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib",
    "build:lib": "vite build --mode lib",
    "build:demo": "vite build --mode demo",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "maplibre-gl": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react-map-gl": "^8.1.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "maplibre-gl": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.4.5",
    "vite": "^6.2.6",
    "vite-plugin-dts": "^4.5.3"
  }
}
